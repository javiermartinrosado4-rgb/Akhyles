# Copia este archivo como server/.env.production en el host de producción.
# Nunca subas el archivo real ni contraseñas al repositorio.
GYM_API_HOST=0.0.0.0
NODE_ENV=production
# Solo con API aislada detrás de Caddy, que sustituye X-Forwarded-For.
GYM_TRUST_PROXY=1
GYM_API_PORT=8082
GYM_DATABASE=/data/akhyles.sqlite

# Orígenes web exactos, separados por comas. Sin barra final.
# Vacío para Android únicamente. Añade el origen HTTPS REAL al habilitar web.
GYM_ALLOWED_ORIGINS=

# Cliente OAuth WEB de Google, terminado en .apps.googleusercontent.com.
# Déjalo vacío hasta completar Google Cloud; no es un secreto.
GYM_GOOGLE_CLIENT_ID=

# Debe coincidir con community_federation_secret de la API de cuentas. Es un
# secreto de servidor a servidor, codificado en base64 y de al menos 32 bytes.
GYM_ACCOUNT_FEDERATION_SECRET=
GYM_ADMIN_ACCOUNT_IDS=

# Dominio del API que tendrá el certificado HTTPS de Caddy.
GYM_API_DOMAIN=api.example.com

# Correo de avisos de certificados HTTPS de Caddy.
CADDY_EMAIL=soporte@example.com
